# Server
BIND_ADDRESS=127.0.0.1:8080
TOKENS_PER_SECOND=30

# Dataset: parquet (deterministic) | live (proxy a real backend)
DATASET_SOURCE=parquet
DATASET_PATH=data/conversations.parquet
TOKENIZER_MODEL=cl100k-base
MODELS=mock-gpt-4o,mock-gpt-4o-mini,mock-reasoner
# MODELS_PATH=data/models.json

# Simulation and API compatibility
NO_LLM_CORS_ORIGINS=*
NO_LLM_SCENARIO=default
NO_LLM_SEED=0
NO_LLM_IDENTITY_MODE=derived
NO_LLM_AUTH_MODE=off
# NO_LLM_AUTH_KEYS=sk-test
# NO_LLM_AUTH_FORBIDDEN_KEYS=sk-revoked
# NO_LLM_CONTROL_PLANE=true
# NO_LLM_CONTROL_TOKEN=change-me
NO_LLM_METRICS=false

# Live mode recording
LIVE_RECORD=false
LIVE_RECORD_PATH=data/live.parquet

# OpenAI credentials (live mode only)
OPENAI_API_KEY=
OPENAI_API_BASE=
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=

# Azure OpenAI credentials (live mode only, takes precedence when endpoint is set)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=2024-06-01
